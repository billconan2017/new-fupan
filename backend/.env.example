# 量脉
LIANGMAI_TOKEN=your_token_here

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=bill
PG_PASSWORD=
PG_DATABASE=fupan_next

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 应用
DEBUG=false
HOST=0.0.0.0
PORT=9009

# 新版量脉请求预算（单位：秒；速率为每分钟请求数）
LIANGMAI_GATEWAY=https://liangmai.pro/api/gateway
LIANGMAI_TIMEOUT=10
LIANGMAI_TOTAL_TIMEOUT=25
LIANGMAI_MAX_ATTEMPTS=3
LIANGMAI_SAFE_RATE=120
LIANGMAI_PEAK_RATE=180
LIANGMAI_CACHE_MAX_ENTRIES=256
# 首次验收完成后再开启采集；仅运行一个 worker
SCHEDULER_ENABLED=false

# 可选：旧系统 market_cache.db 的本机绝对路径，只读访问；默认不接入
LEGACY_MARKET_DB=
